BR2_aarch64=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_ARM_AARCH64=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_AIOS_PATH)/board/qemu-aarch64/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_HOSTNAME="ai-native-os"
BR2_TARGET_GENERIC_ISSUE="Welcome to AI Native OS"
BR2_INIT_NONE=y
# BR2_TARGET_GENERIC_GETTY is not set
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_AIOS_PATH)/board/qemu-aarch64/post-build.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_AIOS_PATH)/board/qemu-aarch64/linux.config"
BR2_LINUX_KERNEL_IMAGE=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_AIOS_PATH)/board/qemu-aarch64/busybox.fragment"
BR2_PACKAGE_AI_OS_INIT=y
BR2_PACKAGE_AIOS=y
BR2_PACKAGE_AIOS_AUDITD=y
BR2_PACKAGE_AIOS_LLAMA=y
BR2_PACKAGE_AIOS_MODELD=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="160M"
BR2_TARGET_ROOTFS_EXT2_LABEL="ai-native-os"
# BR2_TARGET_ROOTFS_TAR is not set
